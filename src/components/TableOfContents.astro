---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings = [] } = Astro.props;

// Filter to only show h2 and h3
const toc = headings.filter((h) => h.depth > 1 && h.depth < 4);
---

{toc.length > 0 && (
  <nav class="toc card mb-8 md:mb-12" aria-labelledby="toc-heading">
    <h2 id="toc-heading" class="kicker mb-4">Table of contents</h2>
    <ul class="space-y-2 text-sm">
      {toc.map((heading) => (
        <li class={heading.depth === 3 ? "ml-4" : ""}>
          <a
            href={`#${heading.slug}`}
            class="text-[var(--color-muted)] hover:text-[var(--color-ink)] hover:underline underline-offset-4 line-clamp-2"
          >
            {heading.text.replace(/\s*#$/, '')}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
