---
interface Props {
  title: string;
  kicker?: string;
  description?: string;
  backUrl?: string;
  backLabel?: string;
  tags?: string[];
}

const {
  title,
  kicker,
  description,
  backUrl = "/",
  backLabel = "Back to portfolio",
  tags = [],
} = Astro.props;
---

<header class="mb-16 md:mb-20">
  <nav class="mb-10" aria-label="Back">
    <a href={backUrl} class="text-link text-sm">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 12H5M12 19l-7-7 7-7"></path>
      </svg>
      {backLabel}
    </a>
  </nav>

  {kicker && <p class="kicker mb-3">{kicker}</p>}

  <h1 class="h1 mb-5">{title}</h1>

  {description && <p class="lead">{description}</p>}

  {
    tags.length > 0 && (
      <ul class="tags mt-6" role="list">
        {tags.map((tag) => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
    )
  }
</header>
