---
interface Props {
  title: string;
  kicker?: string;
  description?: string;
  backUrl?: string;
  backLabel?: string;
  tags?: string[];
}

const {
  title,
  kicker,
  description,
  backUrl = "/portfolio",
  backLabel = "Back to portfolio",
  tags = [],
} = Astro.props;
---

<header class="mb-16 md:mb-20">
  <nav class="mb-10 lg:mb-12">
    <a
      href={backUrl}
      class="inline-flex items-center gap-2 text-sm font-medium text-[#4464AD] dark:text-[#A3B8EE] hover:text-[#5944AD] dark:hover:text-[#C5B3F1] transition-colors duration-200"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M19 12H5M12 19l-7-7 7-7" />
      </svg>
      {backLabel}
    </a>
  </nav>

  {
    kicker && (
      <span class="text-xs font-semibold uppercase tracking-[0.18em] text-[#5944AD] dark:text-[#A096D9] mb-4 block">
        {kicker}
      </span>
    )
  }

  <h1
    class="text-4xl md:text-5xl font-bold tracking-tight leading-[1.15] mb-4 pb-2"
    style="background: linear-gradient(135deg, #A096D9 0%, #9DAFE6 60%, #4498AD 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
  >
    {title}
  </h1>

  <div class="w-12 h-1 rounded-full bg-gradient-to-r from-[#5944AD] to-[#4464AD] mb-8 opacity-70" />

  {
    description && (
      <p class="text-[1.0625rem] leading-relaxed text-[#434448] dark:text-[#D0D7F2] max-w-2xl line-clamp-3">
        {description}
      </p>
    )
  }

  {
    tags.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="text-xs px-2.5 py-1 rounded-full bg-[#EDECF8]/60 dark:bg-[#5944AD]/20 text-[#5944AD] dark:text-[#A096D9] font-medium">
            {tag}
          </span>
        ))}
      </div>
    )
  }
</header>
