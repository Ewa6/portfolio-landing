---
interface Props {
    title: string;
    id: string;
}

const { title, id } = Astro.props;
---

<div class="flex items-center gap-4 mb-6">
    <h2
        id={id}
        class="text-2xl font-medium text-[#111112] dark:text-[#EDECF8]"
    >
        {title}
    </h2>
    <div class="flex-1 border-t border-[#D0D7F2] dark:border-[#434448]"></div>
</div>
