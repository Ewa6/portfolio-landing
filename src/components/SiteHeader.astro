---
// Shared site header: brand mark + name, and links to the home page sections.
// Links use "/#..." so that they also work from the blog pages.
const links = [
    { href: "/#projects", label: "Projects" },
    { href: "/#process", label: "Process" },
    { href: "/blog", label: "Blog" },
    { href: "/#contact", label: "Contact" },
];
---

<header class="site-header">
    <a href="/" class="site-header__brand">
        <img
            src="/brand/mark-colour-on-dark.svg"
            alt=""
            width="32"
            height="32"
            class="hidden dark:block"
        />
        <img
            src="/brand/mark-colour-on-light.svg"
            alt=""
            width="32"
            height="32"
            class="block dark:hidden"
        />
        Ewa Jabłońska
    </a>
    <nav class="site-nav" aria-label="Main">
        <ul role="list">
            {
                links.map((link) => (
                    <li>
                        <a href={link.href}>{link.label}</a>
                    </li>
                ))
            }
        </ul>
    </nav>
</header>
