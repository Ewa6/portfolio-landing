---
import Layout from "../layouts/Layout.astro";

const title = "Page not found";
---

<Layout forceDark title={`${title} | Ewa Jabłońska`}>
  <main class="min-h-[60vh] flex flex-col justify-center py-16">
    <img
      src="/brand/mark-colour-on-dark.svg"
      alt=""
      width="72"
      height="72"
      class="mb-8"
    />

    <p class="kicker mb-3">Error 404</p>

    <h1 class="h1 mb-5">This page does not exist</h1>

    <p class="lead mb-10">
      The page was moved or deleted, or the address is not correct.
    </p>

    <p>
      <a href="/" class="btn btn--primary">
        Back to portfolio
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
      </a>
    </p>
  </main>
</Layout>
