---
const homeUrl = "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redirecting to Ewa Jabłońska's portfolio</title>
    <link rel="canonical" href={homeUrl} />
    <meta http-equiv="refresh" content={`0; url=${homeUrl}`} />
    <script is:inline>
      window.location.replace("/");
    </script>
  </head>
  <body>
    <p>
      The portfolio has moved to the home page.
      <a href={homeUrl}>Go to the portfolio</a>.
    </p>
  </body>
</html>
