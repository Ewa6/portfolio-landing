---
import Layout from "../layouts/Layout.astro";
---

<script is:inline>
    document.documentElement.classList.add("dark");
</script>

<Layout
    title="Portfolio — Ewa Jabłońska"
    description="A connected technical writing portfolio: documentation, process, code, and APIs working as one system."
>
    <main class="max-w-3xl mx-auto px-6 py-20 md:py-32">
        <div class="space-y-20 md:space-y-28">
            {/* ── 0. Page hero / H1 ─────────────────────────────── */}
            <section aria-labelledby="portfolio-heading" class="pb-2">
                {/* Logo */}
                <img
                    src="/logo.png"
                    alt="Ewa Jabłońska Logo"
                    class="h-20 md:h-24 w-auto mb-8 drop-shadow-sm"
                />

                {/* Kicker label */}
                <p
                    class="text-xs font-semibold uppercase tracking-[0.18em] text-[#4464AD] dark:text-[#A3B8EE] mb-4"
                >
                    Technical Writing Portfolio
                </p>

                {/* Visible H1 */}
                <h1
                    id="portfolio-heading"
                    class="text-4xl md:text-5xl font-bold tracking-tight leading-[1.15] mb-6"
                    style="background: linear-gradient(135deg, #A096D9 0%, #9DAFE6 60%, #4498AD 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
                >
                    Ewa Jabłońska
                </h1>

                {/* Decorative rule */}
                <div
                    class="w-12 h-1 rounded-full bg-gradient-to-r from-[#5944AD] to-[#4464AD] mb-8 opacity-70"
                >
                </div>

                {/* Tagline */}
                <p
                    class="text-[1.0625rem] leading-relaxed text-[#434448] dark:text-[#D0D7F2] max-w-2xl"
                >
                    <p>Technical writing is more than content.</p>
                    <br />
                    <p>
                        This portfolio explores how documentation, tooling, and
                        process come together in practice. It reflects that
                        through projects experiments, and continuous learning.
                    </p>
                </p>
            </section>

            {/* ── 1. Concept / Hero ─────────────────────────────── */}
            <section aria-labelledby="concept-heading">
                <div class="flex items-center gap-4 mb-6">
                    <h2
                        id="concept-heading"
                        class="text-2xl font-medium text-[#111112] dark:text-[#EDECF8]"
                    >
                        Concept
                    </h2>
                    <div class="h-px flex-1 bg-[#D0D7F2] dark:bg-[#434448]">
                    </div>
                </div>

                <div class="grid md:grid-cols-2 gap-10 items-start">
                    <div
                        class="space-y-4 text-[1.0625rem] leading-relaxed text-[#434448] dark:text-[#D0D7F2]"
                    >
                        <p>Technical writing does not exist in isolation.</p>
                        <p>
                            Documentation, tooling, and process overlap and
                            influence each other. I use this diagram to show how
                            these areas connect.
                        </p>
                        <p>
                            This portfolio explores those connections across
                            projects and experiments, rather than presenting
                            isolated writing samples. Each section focuses on a
                            different part of that concept.
                        </p>
                    </div>

                    {/* Venn diagram */}
                    <figure class="flex flex-col items-center gap-3">
                        <img
                            src="/Audience Engagement Venn Diagram smaller.png"
                            alt="Venn diagram showing the overlap between Confluence documentation, GitHub code and automation, Jira project management, and REST API integrations — with the portfolio at the intersection"
                            class="w-full max-w-sm h-auto rounded-xl border border-[#D0D7F2] dark:border-[#434448] shadow-sm"
                        />
                    </figure>
                </div>
            </section>

            {/* ── 2. Projects ───────────────────────────────────── */}
            <section aria-labelledby="projects-heading">
                <div class="flex items-center gap-4 mb-6">
                    <h2
                        id="projects-heading"
                        class="text-2xl font-medium text-[#111112] dark:text-[#EDECF8]"
                    >
                        Projects
                    </h2>
                    <div class="h-px flex-1 bg-[#D0D7F2] dark:bg-[#434448]">
                    </div>
                </div>

                {/* Featured project */}
                <div class="mb-8">
                    <a
                        href="/projects/agentic-assistant"
                        id="featured-project-link"
                        class="group block border border-[#D0D7F2] dark:border-[#434448] rounded-xl p-6 hover:border-[#4464AD] dark:hover:border-[#A3B8EE] hover:shadow-md transition-all duration-200 bg-white/50 dark:bg-[#162444]/30"
                    >
                        <div
                            class="flex items-start justify-between gap-4 mb-3"
                        >
                            <div>
                                <span
                                    class="text-xs font-semibold uppercase tracking-widest text-[#4464AD] dark:text-[#A3B8EE] mb-2 block"
                                >
                                    Featured project
                                </span>
                                <h3
                                    class="text-xl font-semibold text-[#111112] dark:text-[#EDECF8] group-hover:text-[#4464AD] dark:group-hover:text-[#A3B8EE] transition-colors duration-200"
                                >
                                    Agentic Assistant
                                </h3>
                            </div>
                            <svg
                                class="shrink-0 mt-1 text-[#D0D7F2] dark:text-[#434448] group-hover:text-[#4464AD] dark:group-hover:text-[#A3B8EE] transition-colors duration-200"
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M5 12h14M12 5l7 7-7 7"></path>
                            </svg>
                        </div>
                        <p
                            class="text-[0.9375rem] leading-relaxed text-[#434448] dark:text-[#D0D7F2]"
                        >
                            The tool automatically retrieves invoices from email
                            using an AI agent. The documentation project
                            separates user documentation (Confluence) and
                            developer docs (docs-as-code), while keeping them
                            aligned within one project.
                        </p>
                        <div class="mt-4 flex flex-wrap gap-2">
                            {
                                [
                                    "Confluence",
                                    "GitHub",
                                    "Jira",
                                    "REST API",
                                ].map((tag) => (
                                    <span class="text-xs px-2.5 py-1 rounded-full bg-[#D0D7F2]/60 dark:bg-[#4464AD]/20 text-[#4464AD] dark:text-[#A3B8EE] font-medium">
                                        {tag}
                                    </span>
                                ))
                            }
                        </div>
                    </a>
                </div>

                {/* Supporting projects grid */}
                <div class="grid sm:grid-cols-2 gap-5">
                    <a
                        href="/projects/api-documentation"
                        id="api-docs-link"
                        class="group block border border-[#D0D7F2] dark:border-[#434448] rounded-xl p-5 hover:border-[#4498AD] dark:hover:border-[#58C1DB] hover:shadow-md transition-all duration-200 bg-white/50 dark:bg-[#041317]/30"
                    >
                        <div class="flex items-center justify-between mb-2">
                            <h3
                                class="text-base font-semibold text-[#111112] dark:text-[#EDECF8] group-hover:text-[#4498AD] dark:group-hover:text-[#58C1DB] transition-colors duration-200"
                            >
                                API Documentation
                            </h3>
                            <svg
                                class="shrink-0 text-[#D0D7F2] dark:text-[#434448] group-hover:text-[#4498AD] dark:group-hover:text-[#58C1DB] transition-colors duration-200"
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M5 12h14M12 5l7 7-7 7"></path>
                            </svg>
                        </div>
                        <p
                            class="text-[0.875rem] leading-relaxed text-[#434448] dark:text-[#D0D7F2]"
                        >
                            REST API documentation with examples, endpoint
                            reference, and integration guidance.
                        </p>
                    </a>

                    <div
                        id="mobile-docs-card"
                        class="block border border-dashed border-[#D0D7F2] dark:border-[#434448] rounded-xl p-5 opacity-60 cursor-not-allowed select-none"
                        aria-label="Mobile documentation — coming soon"
                    >
                        <div class="flex items-center justify-between mb-2">
                            <h3
                                class="text-base font-semibold text-[#111112] dark:text-[#EDECF8]"
                            >
                                Mobile Documentation
                            </h3>
                            <span
                                class="text-[0.7rem] font-semibold uppercase tracking-wider text-[#898A90] dark:text-[#65666C] bg-[#D7D7D9]/50 dark:bg-[#434448]/30 px-2 py-0.5 rounded-full"
                            >
                                Coming soon
                            </span>
                        </div>
                        <p
                            class="text-[0.875rem] leading-relaxed text-[#434448] dark:text-[#D0D7F2]"
                        >
                            Mobile app documentation covering user flows, UI
                            reference, and release notes.
                        </p>
                    </div>
                </div>
            </section>

            {/* ── 3. Process ────────────────────────────────────── */}
            <section aria-labelledby="process-heading">
                <div class="flex items-center gap-4 mb-6">
                    <h2
                        id="process-heading"
                        class="text-2xl font-medium text-[#111112] dark:text-[#EDECF8]"
                    >
                        Process
                    </h2>
                    <div class="h-px flex-1 bg-[#D0D7F2] dark:bg-[#434448]">
                    </div>
                </div>
                <p
                    class="text-[1.0625rem] leading-relaxed text-[#434448] dark:text-[#D0D7F2] mb-6"
                >
                    Showing the work is managed through Jira — from scoping and
                    drafting to review and release. Planning artifacts, ticket
                    structures, and sprint breakdowns are part of the portfolio,
                    not just the outputs.
                </p>
                <a
                    href="#"
                    id="jira-board-link"
                    aria-label="View Jira board — placeholder"
                    class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-[#4498AD] dark:border-[#4498AD] text-[#4498AD] dark:text-[#58C1DB] text-sm font-medium hover:bg-[#4498AD]/10 dark:hover:bg-[#4498AD]/15 transition-all duration-200"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                        <path d="M9 9h6M9 12h6M9 15h4"></path>
                    </svg>
                    View Jira board
                </a>
            </section>

            {/* ── 4. Writing ────────────────────────────────────── */}
            <section aria-labelledby="writing-heading">
                <div class="flex items-center gap-4 mb-6">
                    <h2
                        id="writing-heading"
                        class="text-2xl font-medium text-[#111112] dark:text-[#EDECF8]"
                    >
                        Writing
                    </h2>
                    <div class="h-px flex-1 bg-[#D0D7F2] dark:bg-[#434448]">
                    </div>
                </div>

                <p
                    class="text-[1.0625rem] leading-relaxed text-[#434448] dark:text-[#D0D7F2] mb-6"
                >
                    Legacy blog posts rewritten and republished with a
                    documentation-first approach — clarity over style, structure
                    over impression.
                </p>

                {/* Post preview card */}
                <a
                    href="/blog"
                    id="blog-index-link"
                    class="group block border border-[#D0D7F2] dark:border-[#434448] rounded-xl p-5 hover:border-[#5944AD] dark:hover:border-[#7B6CC7] hover:shadow-md transition-all duration-200 bg-white/50 dark:bg-[#191138]/30 mb-4"
                >
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex-1 min-w-0">
                            <span
                                class="text-xs font-semibold uppercase tracking-widest text-[#5944AD] dark:text-[#A096D9] mb-2 block"
                            >
                                Latest post
                            </span>
                            <h3
                                class="text-base font-semibold text-[#111112] dark:text-[#EDECF8] group-hover:text-[#5944AD] dark:group-hover:text-[#A096D9] transition-colors duration-200 mb-1.5"
                            >
                                If You Love Writing, Technical Writing Might
                                Frustrate You
                            </h3>
                            <p
                                class="text-[0.875rem] leading-relaxed text-[#434448] dark:text-[#D0D7F2] opacity-80 line-clamp-2"
                            >
                                Good writing habits can work against you in
                                technical writing. Here's why clarity, not
                                style, makes the difference.
                            </p>
                            <div class="mt-3 flex flex-wrap gap-2">
                                {
                                    [
                                        "Technical writing",
                                        "Writing skills",
                                        "Career switch",
                                    ].map((tag) => (
                                        <span class="text-xs px-2.5 py-1 rounded-full bg-[#EDECF8]/60 dark:bg-[#5944AD]/20 text-[#5944AD] dark:text-[#A096D9] font-medium">
                                            {tag}
                                        </span>
                                    ))
                                }
                            </div>
                        </div>
                        <svg
                            class="shrink-0 mt-1 text-[#D0D7F2] dark:text-[#434448] group-hover:text-[#5944AD] dark:group-hover:text-[#7B6CC7] transition-colors duration-200"
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="M5 12h14M12 5l7 7-7 7"></path>
                        </svg>
                    </div>
                </a>

                {/* More coming hint */}
                <p class="text-xs text-[#65666C] dark:text-[#898A90]">
                    More posts coming — publishing when there are at least 3.
                </p>
            </section>

            {/* ── 5. Contact ────────────────────────────────────── */}
            <section aria-labelledby="contact-heading">
                <div class="flex items-center gap-4 mb-6">
                    <h2
                        id="contact-heading"
                        class="text-2xl font-medium text-[#111112] dark:text-[#EDECF8]"
                    >
                        Contact
                    </h2>
                    <div class="h-px flex-1 bg-[#D0D7F2] dark:bg-[#434448]">
                    </div>
                </div>
                <p
                    class="text-[1.0625rem] leading-relaxed text-[#434448] dark:text-[#D0D7F2] mb-6"
                >
                    If you'd like to connect, discuss a project, or follow the
                    work in progress:
                </p>
                <div class="flex flex-col sm:flex-row gap-3">
                    <a
                        href="https://www.linkedin.com/in/ejablonska"
                        target="_blank"
                        rel="noopener noreferrer"
                        id="contact-linkedin"
                        class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-lg border border-[#4464AD] dark:border-[#4464AD] text-[#4464AD] dark:text-[#A3B8EE] text-sm font-medium hover:bg-[#4464AD]/10 dark:hover:bg-[#4464AD]/15 transition-all duration-200"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="15"
                            height="15"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                        >
                            <path
                                d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                            ></path>
                            <rect x="2" y="9" width="4" height="12"></rect>
                            <circle cx="4" cy="4" r="2"></circle>
                        </svg>
                        LinkedIn
                    </a>
                    <a
                        href="#"
                        id="contact-slack"
                        aria-label="Slack — placeholder link"
                        class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-lg border border-[#D0D7F2] dark:border-[#434448] text-[#434448] dark:text-[#D0D7F2] text-sm font-medium hover:border-[#4464AD] dark:hover:border-[#A3B8EE] hover:text-[#4464AD] dark:hover:text-[#A3B8EE] transition-all duration-200 opacity-60 cursor-not-allowed"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="15"
                            height="15"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path
                                d="M14.5 10c-.83 0-1.5-.67-1.5-1.5v-5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5z"
                            ></path>
                            <path
                                d="M20.5 10H19V8.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"
                            ></path>
                            <path
                                d="M9.5 14c.83 0 1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5S8 21.33 8 20.5v-5c0-.83.67-1.5 1.5-1.5z"
                            ></path>
                            <path
                                d="M3.5 14H5v1.5c0 .83-.67 1.5-1.5 1.5S2 16.33 2 15.5 2.67 14 3.5 14z"
                            ></path>
                            <path
                                d="M14 14.5c0-.83.67-1.5 1.5-1.5h5c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5h-5c-.83 0-1.5-.67-1.5-1.5z"
                            ></path>
                            <path
                                d="M15.5 19H14v1.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5-.67-1.5-1.5-1.5z"
                            ></path>
                            <path
                                d="M10 9.5C10 8.67 9.33 8 8.5 8H3.5C2.67 8 2 8.67 2 9.5S2.67 11 3.5 11h5c.83 0 1.5-.67 1.5-1.5z"
                            ></path>
                            <path
                                d="M8.5 5H10V3.5C10 2.67 9.33 2 8.5 2S7 2.67 7 3.5 7.67 5 8.5 5z"
                            ></path>
                        </svg>
                        Slack
                        <span
                            class="text-[0.65rem] font-semibold uppercase tracking-wider text-[#898A90] dark:text-[#65666C] bg-[#D7D7D9]/50 dark:bg-[#434448]/30 px-1.5 py-0.5 rounded-full ml-0.5"
                            >soon</span
                        >
                    </a>
                </div>
            </section>
        </div>

        {/* ── Footer ─────────────────────────────────────────── */}
        <footer
            class="mt-24 md:mt-32 pt-8 border-t border-[#D0D7F2] dark:border-[#434448] text-sm flex flex-col md:flex-row justify-between items-center gap-4 text-[#434448] dark:text-[#D0D7F2] opacity-80"
        >
            <p>&copy; {new Date().getFullYear()} Ewa Jabłońska</p>
            <div class="flex items-center gap-6">
                <span class="opacity-70">Built with Astro</span>
                <a
                    href="https://github.com/Ewa6/portfolio-landing"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[#4464AD] dark:text-[#A3B8EE] hover:text-[#5944AD] dark:hover:text-[#C5B3F1] transition-colors"
                >
                    View repo
                </a>
            </div>
        </footer>
    </main>
</Layout>
