---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Venn from "../components/Venn.astro";

// Areas are a colour code (brand/palette.md). Each project sits between two areas
// (brand/graphic-system.md, area map from SCRUM-147).
type Area = "technology" | "product" | "users";
const areaName: Record<Area, string> = {
    technology: "Technology",
    product: "Product",
    users: "Users",
};

// Texts: copy/copy-deck.md v1.0 (approved by Ewa, 2026-11-12/13).
// Order: Promo Video Skill, StickerStart, Quoteable Service API (SCRUM-148).
const projects: {
    id: string;
    title: string;
    areas: [Area, Area];
    skill: string;
    status: "Finished" | "In progress";
    description: string;
    /** Extra link in the description. It is outside the card link (no nested links). */
    extra?: { before: string; text: string; href: string; after: string };
    tags: string[];
    href?: string;
}[] = [
    {
        id: "skill-docs-card",
        title: "Promo Video Skill",
        areas: ["technology", "product"],
        skill: "Docs for people and AI",
        status: "In progress",
        description:
            "Documentation for an AI skill, written so that both the people who use it and the model that runs it can understand what it does, when to use it, and where its limits are.",
        extra: {
            before: "I also made a ",
            text: "pull request",
            href: "https://github.com/krzjablonski/promo-video/pull/1",
            after: " that makes the skill work on Windows and with non-English voiceovers. It is merged.",
        },
        tags: ["Documentation", "AI skills", "Pull request"],
        href: "https://ewa6.github.io/promo-video/",
    },
    {
        id: "stickerstart-card",
        // English name of NieZamulaj (brand decision D17).
        title: "StickerStart",
        areas: ["product", "users"],
        skill: "Brand, marketing, adoption",
        status: "In progress",
        // ON HOLD (copy deck 4.4): the new description and tags go live only
        // when the card links to the case study (SCRUM-149). Until then: old text.
        description:
            "Printable chore boards for families, built and documented with AI as a working partner. The documentation covers the product itself and the story around it: what it is for, who it helps, and why they would pick it.",
        tags: ["AI-assisted", "User documentation", "Product"],
    },
    {
        id: "api-docs-link",
        title: "Quoteable Service API",
        areas: ["technology", "users"],
        skill: "Tutorials, training",
        status: "Finished",
        description:
            "REST API documentation created as the final project for the University of Washington API documentation course: endpoint structure, tutorials, and reference.",
        tags: ["API documentation", "Reference", "Tutorial"],
        href: "https://ewa6.github.io/quoteable-service/",
    },
];

// Latest post: the newest post in src/pages/blog (copy deck 6.2).
const latestPost = Object.values(
    import.meta.glob<{ url: string; frontmatter: Record<string, any> }>(
        "./blog/*.mdx",
        { eager: true },
    ),
)
    .filter((p) => p.frontmatter.date)
    .sort(
        (a, b) =>
            new Date(b.frontmatter.date).getTime() -
            new Date(a.frontmatter.date).getTime(),
    )[0];

const iconProps = {
    xmlns: "http://www.w3.org/2000/svg",
    width: 16,
    height: 16,
    viewBox: "0 0 24 24",
    fill: "none",
    stroke: "currentColor",
    "stroke-width": 2,
    "stroke-linecap": "round",
    "stroke-linejoin": "round",
    "aria-hidden": "true",
};
---

<Layout forceDark
    title="Ewa Jabłońska | Technical writing portfolio"
    description="Technical writer who connects technology, product, and users. Documentation for people and AI, a product case study, and an API documentation sample."
>
    <main class="pt-10 md:pt-16 space-y-16 md:space-y-20">
        {/* ── Hero ─────────────────────────────────────────────── */}
        <div class="space-y-8">
            <section aria-labelledby="portfolio-heading">
                <p class="kicker mb-3">Technical writing portfolio</p>
                <h1 id="portfolio-heading" class="h1 mb-5">Ewa Jabłońska</h1>

                <div class="prose-block lead">
                    <p>Technical writing is more than content.</p>
                    <p>
                        This portfolio explores how technology, product, and
                        users connect. AI can help create documentation, but a
                        technical writer must always keep these three areas in
                        mind.
                    </p>
                </div>

                <ul class="area-legend mt-6" role="list" aria-label="Areas">
                    {
                        (Object.keys(areaName) as Area[]).map((area) => (
                            <li class="area-label">
                                <span class={`node node--${area}`} aria-hidden="true" />
                                {areaName[area]}
                            </li>
                        ))
                    }
                </ul>
            </section>

            {/* ON HOLD (copy deck 2.5, SCRUM-152): the "Live preview" box is
                removed. Its replacement is one line in a .note-box:
                "In November 2026 this portfolio got a new direction. Read why:
                <post title>." Add it when the SCRUM-151 post exists. */}
        </div>

        {/* ── Concept ──────────────────────────────────────────── */}
        <section id="concept" aria-labelledby="concept-heading">
            <SectionHeader title="Concept" id="concept-heading" />

            <div class="prose-block mb-10">
                <p>Technical writing does not exist in isolation.</p>
                <p>
                    Technology, product, and users overlap and influence each
                    other. I use this diagram to show how these areas connect.
                </p>
            </div>

            <Venn />
        </section>

        {/* ── Projects ─────────────────────────────────────────── */}
        <section id="projects" aria-labelledby="projects-heading">
            <SectionHeader title="Projects" id="projects-heading" />

            <p class="prose-block mb-8">
                Three projects. Each one is where two areas meet. Documentation
                is at the centre of each one.
            </p>

            <ul class="grid md:grid-cols-3 gap-4" role="list">
                {
                    projects.map((project) => {
                        const [a, b] = project.areas;
                        return (
                            <li class="flex">
                                {/* The title link covers the whole card (::after).
                                    The extra link sits above it, so links are not nested. */}
                                <div
                                    id={project.id}
                                    class:list={[
                                        "card project-card",
                                        project.href && "project-card--linked",
                                    ]}
                                    style={`--from: var(--color-${a}); --to: var(--color-${b});`}
                                >
                                    <span class="area-label">
                                        <span class="nodes" aria-hidden="true">
                                            <span class={`node node--${a}`} />
                                            <span class={`node node--${b}`} />
                                        </span>
                                        {areaName[a]} + {areaName[b]}
                                    </span>
                                    <span class="skill-label">{project.skill}</span>
                                    <h3>
                                        {project.href ? (
                                            <a
                                                href={project.href}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="project-card__link"
                                            >
                                                {project.title}
                                            </a>
                                        ) : (
                                            project.title
                                        )}
                                    </h3>
                                    <p>
                                        {project.description}
                                        {project.extra && (
                                            <>
                                                {" "}
                                                {project.extra.before}
                                                <a
                                                    href={project.extra.href}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="project-card__extra-link"
                                                >
                                                    {project.extra.text}
                                                </a>
                                                {project.extra.after}
                                            </>
                                        )}
                                    </p>
                                    <div class="project-card__foot">
                                        <ul class="tags" role="list">
                                            {project.tags.map((tag) => (
                                                <li class="tag">{tag}</li>
                                            ))}
                                        </ul>
                                        <span
                                            class:list={[
                                                "status",
                                                project.status === "Finished" &&
                                                    "status--finished",
                                            ]}
                                        >
                                            {project.status}
                                        </span>
                                    </div>
                                </div>
                            </li>
                        );
                    })
                }
            </ul>
        </section>

        {/* ── Process ──────────────────────────────────────────── */}
        <section id="process" aria-labelledby="process-heading">
            <SectionHeader title="Process" id="process-heading" />

            <div class="prose-block mb-8">
                <p>
                    What started as an overwhelming set of ideas became a
                    structured workflow. I plan the work in Jira: epics,
                    sprints, and tasks. Claude Code reads a task and makes the
                    changes in GitHub. I set the direction for each task. I
                    check each change in a local preview and review the pull
                    request before it goes live.
                </p>
                <p>
                    I also use Confluence to document the process itself.
                    Together, these tools show not just the outputs, but how I
                    plan, organize, and deliver the work.
                </p>
            </div>

            <a
                href="https://ewa-doc-lab.atlassian.net/wiki/x/dAC1"
                target="_blank"
                rel="noopener noreferrer"
                id="jira-board-link"
                class="btn btn--primary"
            >
                <svg {...iconProps}>
                    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                    <path d="M9 9h6M9 12h6M9 15h4"></path>
                </svg>
                View Confluence process documentation
            </a>
        </section>

        {/* ── Blog ─────────────────────────────────────────────── */}
        <section id="blog" aria-labelledby="writing-heading">
            <SectionHeader title="Blog" id="writing-heading" />

            <div class="prose-block mb-6">
                <p>
                    Posts from my earlier technical writing blog, revisited and
                    updated to reflect how I approach the field today.
                </p>
            </div>

            <a
                href={latestPost.url}
                id="featured-post-link"
                class="card post-card"
            >
                <div class="flex-1 min-w-0">
                    <span class="kicker">Latest post</span>
                    <h3>{latestPost.frontmatter.title}</h3>
                    <p class="line-clamp-2">
                        {latestPost.frontmatter.description}
                    </p>
                    <ul class="tags mt-3" role="list">
                        {
                            (latestPost.frontmatter.tags ?? []).map((tag: string) => (
                                <li class="tag">{tag}</li>
                            ))
                        }
                    </ul>
                </div>
                <svg {...iconProps} width="18" height="18" class="post-card__arrow">
                    <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
            </a>

            <p class="mt-5">
                <a href="/blog" class="text-link">
                    View all posts
                    <svg {...iconProps}>
                        <path d="M5 12h14M12 5l7 7-7 7"></path>
                    </svg>
                </a>
            </p>
        </section>

        {/* ── Contact ──────────────────────────────────────────── */}
        <section id="contact" aria-labelledby="contact-heading">
            <SectionHeader title="Contact" id="contact-heading" />
            <p class="prose-block mb-6">
                Do you want to talk about documentation for people and AI?
                Write to me:
            </p>
            <div class="flex flex-col sm:flex-row gap-3">
                <a
                    href="https://www.linkedin.com/in/ejablonska"
                    target="_blank"
                    rel="noopener noreferrer"
                    id="contact-linkedin"
                    class="btn btn--secondary"
                >
                    <svg {...iconProps} width="15" height="15" fill="currentColor" stroke="none">
                        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                        <rect x="2" y="9" width="4" height="12"></rect>
                        <circle cx="4" cy="4" r="2"></circle>
                    </svg>
                    LinkedIn
                </a>
                <a
                    href="mailto:ewa.k.jablonska@gmail.com"
                    id="contact-email"
                    class="btn btn--secondary"
                >
                    <svg {...iconProps} width="15" height="15">
                        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                    </svg>
                    Email
                </a>
            </div>
        </section>
    </main>
</Layout>
