---
import Layout from "../../layouts/Layout.astro";
import ContentHeader from "../../components/ContentHeader.astro";
import SectionHeader from "../../components/SectionHeader.astro";
---

<Layout
  title="Agentic Assistant — Ewa Jabłońska"
  description="Documentation project for an AI-powered invoice retrieval tool. Covers user docs (Confluence) and developer docs (docs-as-code)."
>
  <main class="max-w-3xl mx-auto px-6 py-20 md:py-32">
    <ContentHeader
      title="Agentic Assistant"
      kicker="Featured project"
      description="An AI-powered tool that automatically retrieves invoices from email. The documentation separates user docs (Confluence) from developer docs (docs-as-code), while keeping both aligned within one project."
      backUrl="/portfolio"
      backLabel="Portfolio"
      tags={[
        "Developer documentation",
        "User documentation",
        "Confluence",
        "Docs-as-code",
      ]}
    />

    <section aria-labelledby="overview-heading" class="mt-12">
      <SectionHeader title="Overview" id="overview-heading" />
      <div
        class="inline-flex items-center rounded-full bg-[#D0D7F2]/60 dark:bg-[#4464AD]/30 px-4 py-1.5 text-sm font-medium text-[#4464AD] dark:text-[#A3B8EE]"
      >
        <span class="mr-2">🚧</span> Content coming soon
      </div>
    </section>

    <footer
      class="mt-24 md:mt-32 pt-8 border-t border-[#D0D7F2] dark:border-[#434448] text-sm flex flex-col md:flex-row justify-between items-center gap-4 text-[#434448] dark:text-[#D0D7F2] opacity-80"
    >
      <p>&copy; {new Date().getFullYear()} Ewa Jabłońska</p>
    </footer>
  </main>
</Layout>
