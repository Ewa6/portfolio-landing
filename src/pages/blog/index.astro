---
import Layout from "../../layouts/Layout.astro";
import ContentHeader from "../../components/ContentHeader.astro";
import SectionHeader from "../../components/SectionHeader.astro";

// ── Discover all blog posts from the pages/blog directory.
// We exclude the index itself and sort by date descending.
const allPosts = Object.values(import.meta.glob("./*.mdx", { eager: true }));

const posts = allPosts
    .map((post) => ({
        url: post.url ?? "#",
        title: post.frontmatter.title ?? "Untitled",
        description: post.frontmatter.description ?? "",
        date: post.frontmatter.date ?? null,
        tags: post.frontmatter.tags ?? [],
    }))
    .sort((a, b) => {
        if (!a.date) return 1;
        if (!b.date) return -1;
        return new Date(b.date).getTime() - new Date(a.date).getTime();
    });

// ── Lightweight category grouping based on tags / naming convention.
const categories: { label: string; slug: string; tags: string[] }[] = [
    {
        label: "Tools",
        slug: "tools",
        tags: ["Tools", "Excel", "Systems", "Automation"],
    },
    {
        label: "Writing",
        slug: "writing",
        tags: ["Technical writing", "Writing skills", "Career switch"],
    },
    {
        label: "Process",
        slug: "process",
        tags: ["Process", "Planning", "Workflow"],
    },
];

function categoryFor(tags: string[]): string | null {
    for (const cat of categories) {
        if (tags.some((t) => cat.tags.includes(t))) return cat.slug;
    }
    return null;
}

const grouped: Record<string, typeof posts> = {};
const uncategorised: typeof posts = [];

for (const post of posts) {
    const slug = categoryFor(post.tags);
    if (slug) {
        grouped[slug] = grouped[slug] ?? [];
        grouped[slug].push(post);
    } else {
        uncategorised.push(post);
    }
}

// Build final display order: categories that have posts, then uncategorised
const sections: { label: string; posts: typeof posts }[] = [];
for (const cat of categories) {
    if (grouped[cat.slug]?.length) {
        sections.push({ label: cat.label, posts: grouped[cat.slug] });
    }
}
if (uncategorised.length) {
    sections.push({ label: "Other", posts: uncategorised });
}

function formatDate(dateStr: string | null): string {
    if (!dateStr) return "";
    const d = new Date(dateStr);
    return d.toLocaleDateString("en-GB", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
}
---

<Layout forceDark
    title="Blog | Ewa Jabłońska"
    description="Posts about technical writing: clear documentation, tools, and process."
>
    <main class="pt-10 md:pt-16">
        <ContentHeader
            title="Blog"
            kicker="Ewa Jabłońska"
            description="This blog is a space for exploring ideas, approaches, and questions around technical writing."
            backUrl="/"
            backLabel="Back to portfolio"
        />

        {
            posts.length === 0 ? (
                <p class="prose-block">No posts yet.</p>
            ) : (
                <div class="space-y-16 md:space-y-20">
                    {(sections.length > 1
                        ? sections
                        : [{ label: "Articles", posts }]
                    ).map(({ label, posts: listPosts }) => {
                        const slug = label.toLowerCase().replace(/\s+/g, "-");
                        return (
                            <section aria-labelledby={`cat-${slug}`}>
                                <SectionHeader title={label} id={`cat-${slug}`} />
                                <ul class="space-y-4" role="list">
                                    {listPosts.map((post, i) => (
                                        <li>
                                            <a
                                                href={post.url}
                                                id={`post-${slug}-${i}`}
                                                class="card post-card"
                                            >
                                                <div class="flex-1 min-w-0">
                                                    {post.date && (
                                                        <time
                                                            datetime={post.date}
                                                            class="post-card__meta"
                                                        >
                                                            {formatDate(post.date)}
                                                        </time>
                                                    )}
                                                    <h3>{post.title}</h3>
                                                    {post.description && (
                                                        <p class="line-clamp-2">
                                                            {post.description}
                                                        </p>
                                                    )}
                                                    {post.tags.length > 0 && (
                                                        <ul class="tags mt-3" role="list">
                                                            {post.tags.map((tag: string) => (
                                                                <li class="tag">{tag}</li>
                                                            ))}
                                                        </ul>
                                                    )}
                                                </div>
                                                <svg
                                                    class="post-card__arrow"
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="18"
                                                    height="18"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    aria-hidden="true"
                                                >
                                                    <path d="M5 12h14M12 5l7 7-7 7" />
                                                </svg>
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </section>
                        );
                    })}
                </div>
            )
        }
    </main>
</Layout>
