---
import Layout from "../../layouts/Layout.astro";

// ── Discover all blog posts from the pages/blog directory.
// We exclude the index itself and sort by date descending.
const allPosts = await Astro.glob("./*.mdx");

const posts = allPosts
    .map((post) => ({
        url: post.url ?? "#",
        title: post.frontmatter.title ?? "Untitled",
        description: post.frontmatter.description ?? "",
        date: post.frontmatter.date ?? null,
        tags: post.frontmatter.tags ?? [],
    }))
    .sort((a, b) => {
        if (!a.date) return 1;
        if (!b.date) return -1;
        return new Date(b.date).getTime() - new Date(a.date).getTime();
    });

// ── Lightweight category grouping based on tags / naming convention.
const categories: { label: string; slug: string; tags: string[] }[] = [
    {
        label: "Writing",
        slug: "writing",
        tags: ["Technical writing", "Writing skills", "Career switch"],
    },
    {
        label: "Process",
        slug: "process",
        tags: ["Process", "Planning", "Workflow"],
    },
    {
        label: "Tools & Automation",
        slug: "tools",
        tags: ["Documentation", "Systems", "Automation", "Tools"],
    },
];

function categoryFor(tags: string[]): string | null {
    for (const cat of categories) {
        if (tags.some((t) => cat.tags.includes(t))) return cat.slug;
    }
    return null;
}

const grouped: Record<string, typeof posts> = {};
const uncategorised: typeof posts = [];

for (const post of posts) {
    const slug = categoryFor(post.tags);
    if (slug) {
        grouped[slug] = grouped[slug] ?? [];
        grouped[slug].push(post);
    } else {
        uncategorised.push(post);
    }
}

// Build final display order: categories that have posts, then uncategorised
const sections: { label: string; posts: typeof posts }[] = [];
for (const cat of categories) {
    if (grouped[cat.slug]?.length) {
        sections.push({ label: cat.label, posts: grouped[cat.slug] });
    }
}
if (uncategorised.length) {
    sections.push({ label: "Other", posts: uncategorised });
}

function formatDate(dateStr: string | null): string {
    if (!dateStr) return "";
    const d = new Date(dateStr);
    return d.toLocaleDateString("en-GB", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
}
---

<script is:inline>
    document.documentElement.classList.add("dark");
</script>

<Layout
    title="Blog — Ewa Jabłońska"
    description="Writing on technical communication, documentation systems, and the craft of making complex things clear."
>
    <main class="max-w-3xl mx-auto px-6 py-20 md:py-32">
        <div class="space-y-20 md:space-y-28">
            {/* ── 1. Page hero / H1 ───────────────────────────────── */}
            <section aria-labelledby="blog-heading" class="pb-2">
                {/* Kicker label */}
                <p
                    class="text-xs font-semibold uppercase tracking-[0.18em] text-[#5944AD] dark:text-[#A096D9] mb-4"
                >
                    Ewa Jabłońska
                </p>

                {/* Visible H1 */}
                <h1
                    id="blog-heading"
                    class="text-4xl md:text-5xl font-bold tracking-tight leading-[1.15] mb-6"
                    style="background: linear-gradient(135deg, #5944AD 0%, #4464AD 60%, #4498AD 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
                >
                    Blog
                </h1>

                {/* Decorative rule */}
                <div
                    class="w-12 h-1 rounded-full bg-gradient-to-r from-[#5944AD] to-[#4464AD] mb-8 opacity-70"
                >
                </div>

                {/* Intro copy */}
                <div
                    class="space-y-4 text-[1.0625rem] leading-relaxed text-[#434448] dark:text-[#D0D7F2] max-w-2xl"
                >
                    <p>
                        This is where I think out loud about technical writing —
                        not as an isolated skill, but as a layer within a larger
                        system of documentation, tooling, and process.
                    </p>
                    <p>
                        The articles here connect to the same questions I work
                        through in the portfolio: what makes documentation
                        useful, how process shapes output, and where automation
                        can help. Think of this as the editorial thread running
                        alongside the work.
                    </p>
                </div>

                <div class="mt-8">
                    <a
                        href="/portfolio"
                        id="back-to-portfolio"
                        class="inline-flex items-center gap-2 text-sm text-[#4464AD] dark:text-[#A3B8EE] hover:text-[#5944AD] dark:hover:text-[#C5B3F1] transition-colors duration-200"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="M19 12H5M12 19l-7-7 7-7"></path>
                        </svg>
                        Back to portfolio
                    </a>
                </div>
            </section>

            {/* ── 2. Post listing ─────────────────────────────────── */}
            {
                posts.length === 0 ? (
                    <section>
                        <p class="text-[1.0625rem] leading-relaxed text-[#434448] dark:text-[#D0D7F2] opacity-70">
                            No posts yet — publishing soon.
                        </p>
                    </section>
                ) : sections.length > 1 ? (
                    /* Grouped by category */
                    sections.map(({ label, posts: catPosts }) => (
                        <section
                            aria-labelledby={`cat-${label.toLowerCase().replace(/\s+/g, "-")}`}
                        >
                            <div class="flex items-center gap-4 mb-6">
                                <h2
                                    id={`cat-${label.toLowerCase().replace(/\s+/g, "-")}`}
                                    class="text-2xl font-medium text-[#111112] dark:text-[#EDECF8]"
                                >
                                    {label}
                                </h2>
                                <div class="h-px flex-1 bg-[#D0D7F2] dark:bg-[#434448]" />
                            </div>
                            <ul class="space-y-4" role="list">
                                {catPosts.map((post, i) => (
                                    <li>
                                        <a
                                            href={post.url}
                                            id={`post-${label.toLowerCase().replace(/\s+/g, "-")}-${i}`}
                                            class="group block border border-[#D0D7F2] dark:border-[#434448] rounded-xl p-5 hover:border-[#5944AD] dark:hover:border-[#7B6CC7] hover:shadow-md transition-all duration-200 bg-white/50 dark:bg-[#191138]/30"
                                        >
                                            <div class="flex items-start justify-between gap-4">
                                                <div class="flex-1 min-w-0">
                                                    {post.date && (
                                                        <time
                                                            datetime={post.date}
                                                            class="text-xs font-medium text-[#65666C] dark:text-[#898A90] mb-2 block"
                                                        >
                                                            {formatDate(
                                                                post.date,
                                                            )}
                                                        </time>
                                                    )}
                                                    <h3 class="text-base font-semibold text-[#111112] dark:text-[#EDECF8] group-hover:text-[#5944AD] dark:group-hover:text-[#A096D9] transition-colors duration-200 mb-1.5">
                                                        {post.title}
                                                    </h3>
                                                    {post.description && (
                                                        <p class="text-[0.875rem] leading-relaxed text-[#434448] dark:text-[#D0D7F2] opacity-80 line-clamp-2">
                                                            {post.description}
                                                        </p>
                                                    )}
                                                    {post.tags.length > 0 && (
                                                        <div class="mt-3 flex flex-wrap gap-2">
                                                            {post.tags.map(
                                                                (
                                                                    tag: string,
                                                                ) => (
                                                                    <span class="text-xs px-2.5 py-1 rounded-full bg-[#EDECF8]/60 dark:bg-[#5944AD]/20 text-[#5944AD] dark:text-[#A096D9] font-medium">
                                                                        {tag}
                                                                    </span>
                                                                ),
                                                            )}
                                                        </div>
                                                    )}
                                                </div>
                                                <svg
                                                    class="shrink-0 mt-1 text-[#D0D7F2] dark:text-[#434448] group-hover:text-[#5944AD] dark:group-hover:text-[#7B6CC7] transition-colors duration-200"
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="18"
                                                    height="18"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    aria-hidden="true"
                                                >
                                                    <path d="M5 12h14M12 5l7 7-7 7" />
                                                </svg>
                                            </div>
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </section>
                    ))
                ) : (
                    /* Flat list — only one category or none */
                    <section aria-labelledby="all-posts-heading">
                        <div class="flex items-center gap-4 mb-6">
                            <h2
                                id="all-posts-heading"
                                class="text-2xl font-medium text-[#111112] dark:text-[#EDECF8]"
                            >
                                Articles
                            </h2>
                            <div class="h-px flex-1 bg-[#D0D7F2] dark:bg-[#434448]" />
                        </div>
                        <ul class="space-y-4" role="list">
                            {posts.map((post, i) => (
                                <li>
                                    <a
                                        href={post.url}
                                        id={`post-${i}`}
                                        class="group block border border-[#D0D7F2] dark:border-[#434448] rounded-xl p-5 hover:border-[#5944AD] dark:hover:border-[#7B6CC7] hover:shadow-md transition-all duration-200 bg-white/50 dark:bg-[#191138]/30"
                                    >
                                        <div class="flex items-start justify-between gap-4">
                                            <div class="flex-1 min-w-0">
                                                {post.date && (
                                                    <time
                                                        datetime={post.date}
                                                        class="text-xs font-medium text-[#65666C] dark:text-[#898A90] mb-2 block"
                                                    >
                                                        {formatDate(post.date)}
                                                    </time>
                                                )}
                                                <h3 class="text-base font-semibold text-[#111112] dark:text-[#EDECF8] group-hover:text-[#5944AD] dark:group-hover:text-[#A096D9] transition-colors duration-200 mb-1.5">
                                                    {post.title}
                                                </h3>
                                                {post.description && (
                                                    <p class="text-[0.875rem] leading-relaxed text-[#434448] dark:text-[#D0D7F2] opacity-80 line-clamp-2">
                                                        {post.description}
                                                    </p>
                                                )}
                                                {post.tags.length > 0 && (
                                                    <div class="mt-3 flex flex-wrap gap-2">
                                                        {post.tags.map(
                                                            (tag: string) => (
                                                                <span class="text-xs px-2.5 py-1 rounded-full bg-[#EDECF8]/60 dark:bg-[#5944AD]/20 text-[#5944AD] dark:text-[#A096D9] font-medium">
                                                                    {tag}
                                                                </span>
                                                            ),
                                                        )}
                                                    </div>
                                                )}
                                            </div>
                                            <svg
                                                class="shrink-0 mt-1 text-[#D0D7F2] dark:text-[#434448] group-hover:text-[#5944AD] dark:group-hover:text-[#7B6CC7] transition-colors duration-200"
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="18"
                                                height="18"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                aria-hidden="true"
                                            >
                                                <path d="M5 12h14M12 5l7 7-7 7" />
                                            </svg>
                                        </div>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </section>
                )
            }
        </div>

        {/* ── Footer ──────────────────────────────────────────── */}
        <footer
            class="mt-24 md:mt-32 pt-8 border-t border-[#D0D7F2] dark:border-[#434448] text-sm flex flex-col md:flex-row justify-between items-center gap-4 text-[#434448] dark:text-[#D0D7F2] opacity-80"
        >
            <p>&copy; {new Date().getFullYear()} Ewa Jabłońska</p>
            <div class="flex items-center gap-6">
                <span class="opacity-70">Built with Astro</span>
                <a
                    href="https://github.com/Ewa6/portfolio-landing"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[#4464AD] dark:text-[#A3B8EE] hover:text-[#5944AD] dark:hover:text-[#C5B3F1] transition-colors"
                >
                    View repo
                </a>
            </div>
        </footer>
    </main>
</Layout>
