---
import Layout from "./Layout.astro";
import TableOfContents from "../components/TableOfContents.astro";

const { frontmatter, headings } = Astro.props;

const arrowLeft = '<path d="M19 12H5M12 19l-7-7 7-7" />';
const arrowRight = '<path d="M5 12h14M12 5l7 7-7 7" />';
const iconAttrs = {
  xmlns: "http://www.w3.org/2000/svg",
  width: 14,
  height: 14,
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": 2,
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
  "aria-hidden": "true",
};
---

<Layout title={`${frontmatter.title} | Ewa Jabłońska`} description={frontmatter.description}>
  <main class="pt-10 md:pt-16">
    <article class="max-w-[46rem]">
      <header class="mb-12">
        <nav class="mb-10 flex flex-wrap gap-x-6 gap-y-3 text-sm" aria-label="Article navigation">
          <a href="/blog" class="text-link">
            <svg {...iconAttrs} set:html={arrowLeft} />
            Back to blog
          </a>
          <a href="/" class="text-link">
            <svg {...iconAttrs} set:html={arrowLeft} />
            Back to portfolio
          </a>
        </nav>

        <div class="flex flex-wrap items-center gap-3 text-sm text-[var(--color-muted)] mb-6">
          {frontmatter.date && <time datetime={frontmatter.date}>{new Date(frontmatter.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>}
          {frontmatter.tags && (
            <ul class="tags" role="list">
              {frontmatter.tags.map((tag: string) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          )}
        </div>

        <h1 class="h1 mb-6">{frontmatter.title}</h1>

        {frontmatter.description && (
          <p class="lead">{frontmatter.description}</p>
        )}
      </header>

      {frontmatter.editorNote && (
        <div class="card mb-12">
          <p class="kicker mb-2">Editor's note</p>
          <div class="text-[0.95rem] leading-relaxed text-[var(--color-muted)]">
            {frontmatter.editorNote}
          </div>
        </div>
      )}

      {headings && headings.length > 0 && (
        <TableOfContents headings={headings} />
      )}

      <div class="article-content mt-12 md:mt-16">
        <slot />
      </div>

      <nav class="mt-16 border-t border-[var(--color-line)] pt-8 flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between" aria-label="Article footer navigation">
        <a href="/blog" class="btn btn--secondary">
          <svg {...iconAttrs} width="15" height="15" set:html={arrowLeft} />
          Back to blog navigation
        </a>
        {frontmatter.nextPostUrl && (
          <a href={frontmatter.nextPostUrl} aria-label={`Next post: ${frontmatter.nextPostLabel ?? "Read another post"}`} class="btn btn--secondary">
            Next post
            <svg {...iconAttrs} width="15" height="15" set:html={arrowRight} />
          </a>
        )}
      </nav>
    </article>
  </main>
</Layout>
