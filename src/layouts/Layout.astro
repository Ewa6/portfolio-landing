---
import "../styles/global.css";
import CookieConsent from "../components/CookieConsent.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
  /** Dark mode only (brand: dark first). Blog articles follow the visitor's setting. */
  forceDark?: boolean;
}

const {
  title = "Ewa Jabłońska | Technical writing portfolio",
  description = "Technical writer who connects technology, product, and users. Documentation for people and AI, a product case study, and an API documentation sample.",
  forceDark = false,
} = Astro.props;
---

<!doctype html>
<html
  lang="en"
  class={forceDark ? "dark" : undefined}
  data-force-dark={forceDark ? "" : undefined}
>
  <head>
    <script is:inline>
      // Set the colour mode before the first paint.
      (() => {
        const root = document.documentElement;
        if (root.hasAttribute("data-force-dark")) return;
        let theme = null;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        if (!theme) {
          theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        root.classList.toggle("dark", theme === "dark");
      })();
    </script>
    <!-- Google tag (gtag.js), loaded only after cookie consent -->
    <script is:inline>
      (() => {
        const GA_ID = "G-GQH2FEWXXW";
        const KEY = "cookie-consent";
        // Ask again after about 12 months.
        const MAX_AGE = 365 * 24 * 60 * 60 * 1000;

        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          dataLayer.push(arguments);
        };
        gtag("consent", "default", {
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
          analytics_storage: "denied",
        });
        gtag("js", new Date());
        gtag("config", GA_ID);

        let loaded = false;
        const loadGA = () => {
          window["ga-disable-" + GA_ID] = false;
          gtag("consent", "update", { analytics_storage: "granted" });
          if (loaded) return;
          loaded = true;
          const s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_ID;
          document.head.appendChild(s);
        };

        const clearGACookies = () => {
          const host = location.hostname;
          const domains = ["", host, "." + host, "." + host.replace(/^www\./, "")];
          document.cookie.split(";").forEach((c) => {
            const name = c.split("=")[0].trim();
            if (!name.startsWith("_ga")) return;
            domains.forEach((d) => {
              document.cookie =
                name + "=; Max-Age=0; path=/" + (d ? "; domain=" + d : "");
            });
          });
        };

        const get = () => {
          try {
            const saved = JSON.parse(localStorage.getItem(KEY) || "null");
            if (saved && Date.now() - saved.t < MAX_AGE) return saved.v;
          } catch {}
          return null;
        };

        const set = (value) => {
          try {
            localStorage.setItem(KEY, JSON.stringify({ v: value, t: Date.now() }));
          } catch {}
          if (value === "granted") {
            loadGA();
          } else {
            window["ga-disable-" + GA_ID] = true;
            gtag("consent", "update", { analytics_storage: "denied" });
            clearGACookies();
          }
        };

        window.cookieConsent = { get, set };
        if (get() === "granted") loadGA();
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B1020" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Inter is served from this site: no request to Google Fonts before consent. -->
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="min-h-screen antialiased">
    <div class="page">
      <SiteHeader />
      <slot />
      <SiteFooter />
    </div>
    <CookieConsent />
  </body>
</html>
